# ===========================================================================
# LeakLens data-layer - environment template
#
# SETUP (one command, from inside data-layer/):
#   cp .env.example .env
# then paste your real key into .env and never commit that file.
# .env is git-ignored; .env.example (this file) is the only one tracked.
#
# Verify the key works BEFORE the demo with:
#   npm run verify-gonka
# ===========================================================================


# --- Gonka Router (required for AI severity analysis) ----------------------

# Your hackathon API key. Format looks like: sk-xxxxxxxxxxxxxxxx
# Get it from https://gonkarouter.io - participants receive free credits.
# Leave blank and the app still runs: breach lookup works and the dashboard
# shows the AI panel as unavailable instead of crashing.
GONKA_API_KEY=

# The OpenAI-compatible inference gateway. Keep the /v1 suffix - the SDK
# appends only "/chat/completions" to this value.
GONKA_BASE_URL=https://api.gonkarouter.io/v1

# The two independent models used for cross-verification. Model IDs are
# CASE-SENSITIVE. If either 404s, run `npm run verify-gonka` to print the
# exact list your key can reach, then paste the correct IDs here.
GONKA_MODEL_PRIMARY=MiniMaxAI/MiniMax-M2.7
GONKA_MODEL_SECONDARY=deepseek-ai/DeepSeek-V4-Flash-0731


# --- Tuning (safe defaults, override only if needed) -----------------------

# Server port. The dashboard defaults to this same value.
PORT=4000

# Max model calls in flight at once, and how long one call may take.
GONKA_MAX_CONCURRENCY=6
GONKA_TIMEOUT_MS=120000

# Cap on how many breaches get AI-analysed per scan, so an email found in
# 40 breaches does not make a live demo hang.
MAX_BREACHES_ANALYZED=3

# How long a breach lookup stays cached, in milliseconds (default 15 min).
# Protects the XposedOrNot quota of 25 requests/hour.
CACHE_TTL_MS=900000

# Our own public rate limit, per IP per window.
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=60
RATE_LIMIT_MAX_ANALYSES=20

# Comma-separated allowed origins for CORS. Leave blank to allow any origin
# (fine for local demo). Set it to your deployed dashboard URL in production.
CORS_ORIGINS=
